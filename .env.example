# mock = offline rule-based provider (no key needed). openai = any OpenAI-compatible API.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. For a local Ollama model: http://localhost:11434/v1
OPENAI_BASE_URL=
MAX_OUTPUT_TOKENS=400
# Optional shared secret. When set, every API call must send it in the X-API-Key header.
API_TOKEN=
LEADS_DB=
